{
  "$id": "https://riviera.org/schemas/rules/riviera.rules-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Riviera rule pack",
  "description": "Rules for one domain (interiors, retail, gyms, pools, and later kitchens), from one code, standard or guide (ARC-RULE-001). Lengths are metres. New rule kinds are added to this format as their tools are built. Bathroom and vertical-transport packs keep their own formats. MIT licensed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "title",
    "domain",
    "jurisdiction",
    "edition",
    "layer"
  ],
  "properties": {
    "format": {
      "const": "riviera.rules-1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Unique among the packs a project can use; a project pack with a shipped pack's id replaces it."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z_]+$",
      "description": "What it governs: interiors, kitchen, foodservice, refrigeration, retail, checkout, gym, …"
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1,
      "description": "Where it applies: US, England, …"
    },
    "edition": {
      "type": "string",
      "minLength": 1,
      "description": "The editions and clauses its values come from."
    },
    "layer": {
      "enum": [
        "minimum",
        "accessible",
        "recommended"
      ],
      "description": "A code minimum, an accessibility standard, or guidance (findings are notes)."
    },
    "notes": {
      "type": "string"
    },
    "zones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/zone"
      }
    },
    "headroom": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/headroom"
      }
    },
    "projections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projection"
      }
    },
    "heights_over": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/height_over"
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "pool": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pool_rule"
      },
      "description": "Swimming-pool rules (ARC-POOL-002), checked by pool.check against each pool element."
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": [
        "id",
        "description",
        "applies_to",
        "source",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The clause it comes from, e.g. `ADA 2010 806.2.3`."
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "applies_to": {
          "$ref": "#/$defs/selector"
        },
        "occupancy": {
          "enum": [
            "any",
            "dwelling",
            "other"
          ],
          "description": "Where it applies, as the building code settings name occupancies (default any)."
        },
        "source": {
          "type": "string",
          "pattern": "^S[0-9]{4}( S[0-9]{4})*$",
          "description": "Source IDs in SOURCE_REGISTER.md."
        },
        "confidence": {
          "enum": [
            "verified",
            "secondary",
            "advisory"
          ]
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "The elements a rule applies to. Each list names alternatives; an element must match every list given. Compared without case.",
      "properties": {
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^Ifc[A-Za-z]+$"
          }
        },
        "predefined_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "object_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "zone": {
      "allOf": [
        {
          "$ref": "#/$defs/rule"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "across",
        "out"
      ],
      "properties": {
        "id": true,
        "description": true,
        "applies_to": true,
        "occupancy": true,
        "source": true,
        "confidence": true,
        "across": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/across"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "out": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/out"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "How high above the floor it is kept clear (default 1.0 m)."
        },
        "door_swing": {
          "enum": [
            "allowed",
            "forbidden"
          ],
          "description": "Whether a door may swing into it (default allowed)."
        },
        "allows": {
          "$ref": "#/$defs/selector",
          "description": "Elements that may stand in it, such as a dining table's chairs (default none)."
        }
      }
    },
    "across": {
      "type": "array",
      "prefixItems": [
        {
          "enum": [
            "centre",
            "left",
            "right"
          ]
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "description": "A position across the element, from its centre line or its left or right edge as one faces its front, positive to the right."
    },
    "out": {
      "type": "array",
      "prefixItems": [
        {
          "enum": [
            "front",
            "back"
          ]
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "description": "A position from the element's front, positive in front of it, or from its back, positive behind it."
    },
    "headroom": {
      "allOf": [
        {
          "$ref": "#/$defs/rule"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "min"
      ],
      "description": "The clear height an element's bottom keeps above the floor, unless it is over an element unless_over selects.",
      "properties": {
        "id": true,
        "description": true,
        "applies_to": true,
        "occupancy": true,
        "source": true,
        "confidence": true,
        "min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unless_over": {
          "$ref": "#/$defs/selector"
        }
      }
    },
    "projection": {
      "allOf": [
        {
          "$ref": "#/$defs/rule"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "band",
        "max"
      ],
      "description": "How far an element may project from its wall where it lies between two heights above the floor.",
      "properties": {
        "id": true,
        "description": true,
        "applies_to": true,
        "occupancy": true,
        "source": true,
        "confidence": true,
        "band": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "max": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "height_over": {
      "allOf": [
        {
          "$ref": "#/$defs/rule"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "over"
      ],
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        }
      ],
      "description": "How far an element's bottom stays above the top of an element under it that over selects.",
      "properties": {
        "id": true,
        "description": true,
        "applies_to": true,
        "occupancy": true,
        "source": true,
        "confidence": true,
        "over": {
          "$ref": "#/$defs/selector"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "surface": {
      "allOf": [
        {
          "$ref": "#/$defs/rule"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "description": "A surface's height above the floor and its length (an accessible counter portion: 36 in long at most 36 in high).",
      "anyOf": [
        {
          "required": [
            "height_max"
          ]
        },
        {
          "required": [
            "height_min"
          ]
        },
        {
          "required": [
            "length_min"
          ]
        }
      ],
      "properties": {
        "id": true,
        "description": true,
        "applies_to": true,
        "occupancy": true,
        "source": true,
        "confidence": true,
        "height_min": {
          "type": "number",
          "minimum": 0
        },
        "height_max": {
          "type": "number",
          "minimum": 0
        },
        "length_min": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "pool_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "check",
        "source",
        "confidence"
      ],
      "description": "A rule on a swimming pool. `check` names what is measured; min and max bound it. Slopes are rise over run; depths are below the water; distances are metres.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The clause it comes from, e.g. `MAHC 2024 4.5.2.1`."
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "pattern": "^S[0-9]{4}( S[0-9]{4})*$"
        },
        "confidence": {
          "enum": [
            "verified",
            "secondary",
            "advisory"
          ]
        },
        "check": {
          "enum": [
            "shallow_slope",
            "deep_slope",
            "shallow_end_depth",
            "depth",
            "cove_radius",
            "coping_overhang",
            "coping_thickness",
            "deck_width",
            "infinity_edge",
            "entries",
            "accessible_entries",
            "drains",
            "bather_load",
            "stair_tread",
            "stair_riser",
            "stair_width",
            "sloped_entry_slope",
            "sloped_entry_depth",
            "bench_seat"
          ],
          "description": "shallow_slope and deep_slope: each profile segment's slope above or below the 5 ft break (max); shallow_end_depth: the shallowest depth (min, max); depth: the deepest (max); cove_radius: the wall–floor radius (max), where the pool's shallowest is at most depth_up_to; coping_overhang and coping_thickness (min, max); deck_width: clear deck round the whole edge (min); infinity_edge: the share of the edge that is vanishing (max); entries: elements counts selects within near of the water's edge (min); accessible_entries: as entries, with min where the pool wall is at least perimeter long and 1 below it, and at least one primary; drains: suction outlets counts selects inside the pool, at least min unless one has a cover at least cover in size, spacing apart; bather_load: the water's area per bather (min, reported). The pool's own entries (ARC-POOL-003): stair_tread, stair_riser and stair_width (min, max) for each set of stairs; sloped_entry_slope (max) and sloped_entry_depth (min, max: how far below the water it reaches) for each sloped entry; bench_seat (min, max: the seat below the water), with water_depth_max the deepest water a bench may stand in. Stairs count as `Pool Stairs` and a sloped entry as `Sloped Entry` where entries and accessible_entries select them."
        },
        "pools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "public",
              "competition",
              "residential",
              "wading"
            ]
          },
          "description": "The pool classes it applies to (default all)."
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "depth_up_to": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "counts": {
          "$ref": "#/$defs/selector"
        },
        "primary": {
          "$ref": "#/$defs/selector"
        },
        "perimeter": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "near": {
          "type": "number",
          "minimum": 0
        },
        "spacing": {
          "type": "number",
          "minimum": 0
        },
        "cover": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "water_depth_max": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
