#22=IFCTRANSPORTELEMENTTYPE('1kVwJE6LP4yPTbiysQobAy',$,'Pool lift, 300 lb','A deck-anchored pool lift: a seat 23 in wide (S.R. Smith aXs2) its top 17 in over the deck (ADA 1009.2.5: 16\X2\2013\X0\19 in), lifting 300 lb; the seat swings over the water at its front. Keep the ADA''s 36 \X2\00D7\X0\ 48 in clear deck behind it, and set it where the water is 48 in deep or less.',$,(#1907),(#107),$,'Pool Lift',.USERDEFINED.);
#23=IFCFURNITURETYPE('3kZuhFBW50AO63$hb_05pP',$,'Pool ladder, 3 steps','A three-step ladder of 1.90 in stainless rails 21 in apart (the MAHC''s 17\X2\2013\X0\24 in), 0.9 m over the deck, treads 12 in apart 75 mm off the wall (3\X2\2013\X0\4 in) (S.R. Smith LF series). Its insertion point is the pool wall''s face, the treads at its front in the water.',$,(#1914),(#117),$,'Pool Ladder',.NOTDEFINED.,.USERDEFINED.);
#24=IFCFURNITURETYPE('2OrZaO7B9Bb8jXbmSh_rj7',$,'Starting platform 24 \X2\00D7\X0\ 32 in','A starting platform with a 24 \X2\00D7\X0\ 32 in top (Spectrum Record Breaker) 0.6 m over the deck: 0.75 m over the water with it 0.15 m down (FINA 0.50\X2\2013\X0\0.75 m); its front edge at the water. Water 1.35 m deep at least under it (FINA), 6 ft for new pools (MAHC 4.8.3).',$,(#1921),(#127),$,'Starting Platform',.NOTDEFINED.,.USERDEFINED.);
#25=IFCFURNITURETYPE('1fDS2XU9fEfRvWCo1ZGqHO',$,'Lifeguard chair 6 ft','A portable lifeguard chair, its seat 6 ft up on a 52 \X2\00D7\X0\ 42 in footprint (S.R. Smith Vista), facing the water at its front; the MAHC keeps 4 ft of deck clear round it.',$,(#1928),(#137),$,'Lifeguard Chair',.NOTDEFINED.,.USERDEFINED.);
#26=IFCFURNITURETYPE('2zjBrr63n9qBNoydtv7ABn',$,'Main drain cover 300 \X2\00D7\X0\ 300','A blockable main drain cover 300 \X2\00D7\X0\ 300 mm, set in the pool floor: pairs at least 3 ft apart (VGB, WAC 246-260).',$,(#1935),(#147),$,'Main Drain',.NOTDEFINED.,.USERDEFINED.);
